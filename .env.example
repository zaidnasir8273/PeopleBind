# Frontend (Vite) -- safe to expose in the browser bundle. The anon key is
# meant to be public; every real access control is enforced by Supabase
# Row Level Security, not by keeping this secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------
# Everything below is NOT a frontend env var -- never prefix a secret
# with VITE_ or it ships in the browser bundle. These are configured as
# Supabase Edge Function secrets (Dashboard -> Edge Functions -> Secrets,
# or `supabase secrets set`), not in this file, and are only ever read
# from Deno.env inside a function that runs server-side.
# ---------------------------------------------------------------------

# Used by the `ai-assistant` and `generate-support-draft` edge functions
# to call Anthropic's Messages API.
# ANTHROPIC_API_KEY=

# Used by the `send-email` edge function.
# RESEND_API_KEY=
# EMAIL_FROM= (optional -- defaults to a Resend sandbox address)
